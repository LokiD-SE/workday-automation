[Unit]
Description=Workday: Bizom VPN agent (credentials + authenticator-code popup for bizom-vpn.service)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/Workspace/workday-automation/bin/day vpn agent
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
